<%= tag.div(**html_attributes(nil, @html, data: controller_data)) do %>
  <%= render Componeer::Popover::Component.new(align: @align) do |popover| %>
    <% popover.with_trigger do %>
      <button type="button" class="tr-trigger" aria-haspopup="dialog" aria-expanded="false" aria-label="<%= @label %>">
        <% if @icon %><%= icon_svg(@icon) %><% end %>
        <span class="tr-trigger__text" data-componeer--multi-select-target="summary"><%= summary %></span>
        <%= icon_svg("chevron-down", size: 14) %>
      </button>
    <% end %>
    <div class="tr-menu" role="dialog" aria-label="<%= @label %>">
      <% if @searchable %>
        <div class="tr-menu__search">
          <input class="tr-input" type="search" placeholder="<%= @search_placeholder %>" aria-label="<%= @search_placeholder %>"
            data-action="input->componeer--multi-select#search" data-componeer--multi-select-target="query">
        </div>
      <% end %>
      <label class="tr-menu__all">
        <input class="tr-check" type="checkbox" <%= "checked" if all_checked? %> data-componeer--multi-select-target="all" data-action="change->componeer--multi-select#toggleAll">
        <%= @all_label %>
      </label>
      <div class="tr-menu__list">
        <input type="hidden" name="<%= @name %>[]" value="">
        <% @options.each do |option| %>
          <label class="tr-menu__opt" data-componeer--multi-select-target="option" data-label="<%= option.label.to_s.downcase %> <%= option.sub.to_s.downcase %>">
            <input class="tr-check" type="checkbox" name="<%= @name %>[]" value="<%= option.value %>" <%= "checked" if checked?(option) %>
              data-componeer--multi-select-target="checkbox" data-action="change->componeer--multi-select#change" data-option-label="<%= option.label %>">
            <span style="display: flex; flex-direction: column; min-width: 0">
              <span class="tr-menu__name">
                <% if option.status || option.color %><%= render Componeer::StatusDot::Component.new(option.status || :neutral, color: option.color) %><% end %>
                <%= option.label %>
              </span>
              <% if option.sub %><span class="tr-menu__sub"><%= option.sub %></span><% end %>
            </span>
          </label>
        <% end %>
        <p class="tr-menu__none" hidden data-componeer--multi-select-target="none">Nada encontrado.</p>
      </div>
      <div class="tr-menu__foot">
        <button type="button" class="tr-btn tr-btn--sm" data-action="componeer--popover#close">Fechar</button>
      </div>
    </div>
  <% end %>
<% end %>
