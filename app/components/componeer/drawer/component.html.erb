<%= tag.aside(**html_attributes("tr-drawer", @html, aria: { label: @title }, data: { controller: "componeer--dismissable", action: "keydown.esc@window->componeer--dismissable#dismiss" })) do %>
  <div class="tr-drawer__head">
    <div class="tr-drawer__top">
      <div style="flex: 1; min-width: 0">
        <% if @eyebrow %><p class="tr-muted" style="margin-bottom: 4px"><%= @eyebrow %></p><% end %>
        <h2 style="margin: 0"><%= @title %></h2>
      </div>
      <%= render Componeer::IconButton::Component.new("x", label: "Fechar", href: @close_href, data: { "componeer--dismissable-target": "close", action: (@close_href ? nil : "componeer--dismissable#dismiss") }) %>
    </div>
    <%= meta %>
    <% if actions? %><div class="tr-drawer__actions"><% actions.each do |action| %><%= action %><% end %></div><% end %>
  </div>
  <div class="tr-drawer__body">
    <% sections.each do |section| %><%= section %><% end %>
    <%= content %>
  </div>
<% end %>
