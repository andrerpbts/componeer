<% gallery = Componeer::IconGallery.new(variant: params[:variant], letter: params[:letter], query: params[:q], page: params[:page]) %>
<% gallery_url = ->(**changes) { componeer.doc_path("icon", **gallery.params_with(**changes), anchor: "all-icons") } %>
<div class="doc-icons" id="all-icons" data-controller="docs-icons">
  <form action="<%= componeer.doc_path("icon", anchor: "all-icons") %>" method="get" class="tr-filters" style="padding: 0">
    <input type="hidden" name="variant" value="<%= gallery.variant %>">
    <% if gallery.letter %><input type="hidden" name="letter" value="<%= gallery.letter %>"><% end %>
    <%= search_input name: :q, value: gallery.query, placeholder: "Buscar ícone (ex.: calendar, arrow, user)" %>
    <%= button "Buscar", type: "submit" %>
    <%= segmented(label: "Variante") do |variants| %>
      <% %i[outline filled].each do |variant| %>
        <% variants.with_item "#{variant.to_s.capitalize} · #{gallery.count(variant)}",
             href: gallery_url.(variant: variant), pressed: gallery.variant == variant %>
      <% end %>
    <% end %>
  </form>

  <nav class="tr-pagination" aria-label="Ícones por letra">
    <% if gallery.searching? %>
      <%= link_to "Todas", gallery_url.(letter: nil), class: "tr-btn tr-btn--sm", aria: { current: (gallery.letter.nil? ? "page" : nil) } %>
    <% end %>
    <% gallery.letters.each do |letter, count| %>
      <% if count.zero? %>
        <span class="tr-btn tr-btn--sm doc-letter" aria-disabled="true" title="Nenhum ícone"><%= letter.upcase %></span>
      <% else %>
        <%= link_to letter.upcase, gallery_url.(letter: letter), class: "tr-btn tr-btn--sm doc-letter",
              title: pluralize(count, "ícone", plural: "ícones"), aria: { current: (letter == gallery.letter ? "page" : nil) } %>
      <% end %>
    <% end %>
  </nav>

  <p class="tr-muted" data-docs-icons-target="status" aria-live="polite">
    <%= pluralize(gallery.matches.size, "ícone", plural: "ícones") %>
    <% if gallery.searching? %>com “<%= gallery.query %>”<% end %>
    <% if gallery.letter %>na letra <%= gallery.letter.upcase %><% end %>
    <% if gallery.pages > 1 %>· página <%= gallery.page %> de <%= gallery.pages %><% end %>
    <% if gallery.searching? %>· <%= link_to "Limpar busca", gallery_url.(q: nil) %><% end %>
    · clique num ícone para copiar o código.
  </p>

  <% if gallery.names.any? %>
    <div class="doc-icon-grid">
      <% gallery.names.each do |name| %>
        <button type="button" class="doc-icon" title="<%= name %>" data-code="<%= icon_code(name, gallery.variant) %>"
          data-action="docs-icons#copy"><%= icon name, size: 32, variant: gallery.variant %><span><%= name %></span></button>
      <% end %>
    </div>
    <%= pagination page: gallery.page, pages: gallery.pages, url: ->(page) { gallery_url.(page: page) }, label: "Páginas de ícones" %>
  <% else %>
    <%= empty_state "Nenhum ícone encontrado", icon: "search",
          description: (gallery.letter ? "Nenhum ícone com “#{gallery.query}” na letra #{gallery.letter.upcase}." : "Tente outra palavra, em inglês.") %>
  <% end %>
</div>
