<%= page_header(title: @page.title, subtitle: @page.lead) %>
<article class="doc-article">
  <% if @page.helper %>
    <%= code_block @page.helper, language: :ruby, title: "Helper", class: "doc-signature" %>
  <% end %>
  <% @page.sections.each do |section| %>
    <section class="doc-section">
      <% if section.heading %><h2><%= section.heading %></h2><% end %>
      <%= render "componeer/docs/text", text: section.text if section.text %>
      <%= code_block section.code, language: section.language if section.code %>
      <% if section.example %>
        <%= render layout: "componeer/docs/example",
              locals: { id: "example-#{section.example.dasherize}", source: example_source(section.example) } do %>
          <div class="doc-example__preview tr-root"><%= render "componeer/docs/examples/#{section.example}" %></div>
        <% end %>
      <% end %>
      <%= render "componeer/docs/icon_gallery" if section.gallery == "icons" %>
      <%= render "componeer/docs/token_table" if section.gallery == "tokens" %>
      <% if section.screen %>
        <div class="doc-screen">
          <%= cluster do %>
            <%= button "Abrir em tela cheia", href: componeer.screen_path(section.screen), icon: "external-link", target: "_blank" %>
          <% end %>
          <%= render layout: "componeer/docs/example",
                locals: { id: "screen-#{section.screen.dasherize}", source: screen_source(section.screen) } do %>
            <iframe class="doc-screen__frame" src="<%= componeer.screen_path(section.screen) %>"
              title="<%= section.heading || @page.title %>" loading="lazy"></iframe>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>
  <% if @page.options.any? %>
    <section class="doc-section">
      <h2>Options</h2>
      <%= table(rows: @page.options) do |t| %>
        <% t.column("Option") { |option| tag.code(option.name) } %>
        <% t.column("What it does") { |option| tag.span(option.description, style: "white-space: normal") } %>
      <% end %>
    </section>
  <% end %>
  <% if @page.slots.any? %>
    <section class="doc-section">
      <h2>Slots</h2>
      <%= table(rows: @page.slots) do |t| %>
        <% t.column("Slot") { |slot| tag.code(slot.name) } %>
        <% t.column("What goes in it") { |slot| tag.span(slot.description, style: "white-space: normal") } %>
      <% end %>
    </section>
  <% end %>
</article>
